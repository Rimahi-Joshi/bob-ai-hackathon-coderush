# Copy this file to .env (in this src/ folder) and fill in what you need.
# Nothing here is required for the demo: with the defaults the app runs
# fully offline on saved AI answers.

# mock = offline, uses saved answers (default)
# bob  = IBM Bob through Bob Shell (needs the `bob` command and BOB_API_KEY)
# live = IBM watsonx.ai (needs the WATSONX_ values below)
LLM_MODE=mock

# Which case in data/seed/ "Load demo case" opens: case (default) or case_2
SEED_CASE=case

# Port the web app listens on
PORT=8000

# IBM Bob, only for LLM_MODE=bob. Install Bob Shell first:
#   curl -fsSL https://bob.ibm.com/download/bobshell.sh | bash
# Create the key in the Bob web portal with Scope = Inference.
BOB_API_KEY=your-bob-api-key
# Only for keys that are not Inference-scoped
BOB_TEAM_ID=
# Spending cap per question, in Bobcoins
BOB_MAX_COST=2
# Path to the bob command, if it is not on PATH
BOB_BIN=

# IBM watsonx.ai, only for LLM_MODE=live. Never commit real values.
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-3-8b-instruct
